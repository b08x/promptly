#!/usr/bin/env ruby
# frozen_string_literal: true

lib_dir = File.expand_path(File.join(__dir__, '..', 'lib'))
$LOAD_PATH.unshift lib_dir unless $LOAD_PATH.include?(lib_dir)

require 'gli'
require 'tty-config'
require 'fileutils'

# Initialize configuration
$config = TTY::Config.new
$config.append_path(Dir.home)
$config.append_path(File.join(Dir.home, '.config', 'promptly'))

# Set default configuration values
$config.set(:prompts_directory, value: File.expand_path('prompts', Dir.pwd))
$config.set(:default_editor, value: ENV['EDITOR'] || 'nano')

# Read existing config if it exists
config_file = File.join(Dir.home, '.config', 'promptly', 'config.yml')
if File.exist?(config_file)
  $config.read(config_file)
else
  # Create config directory and file with defaults
  FileUtils.mkdir_p(File.dirname(config_file))
  $config.write(config_file, format: :yaml)
end

begin
  require 'promptly'
rescue LoadError
  warn 'In development, you need to use `bundle exec bin/promptly` to run your app'
  warn 'At install-time, RubyGems will make sure lib, etc. are in the load path'
  exit 64
end

exit Promptly::CLI.run(ARGV)
